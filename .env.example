# === Database ===
DATABASE_URL="file:./dev.db"

# === Auth ===
AUTH_SECRET="generate-a-long-random-string"

# === PayPal (sandbox — developer.paypal.com > Apps & Credentials) ===
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-sandbox-client-secret"
# Merchant ID of the PLATFORM sandbox business account (receives commission)
PAYPAL_PLATFORM_MERCHANT_ID="your-platform-merchant-id"
# Merchant ID of a SELLER sandbox business account — only used in multi_unit mode
PAYPAL_SELLER_MERCHANT_ID=""
# "payout" works in every sandbox; "multi_unit" needs payee consent/partner onboarding
PAYPAL_SPLIT_MODE="payout"
# Marketplace commission in basis points: 1000 = 10%
PLATFORM_FEE_BPS="1000"

# === AI (OpenAI-compatible: OpenAI, OpenRouter, Groq, Ollama...) ===
OPENAI_API_KEY="your-api-key"
# Optional — ONLY set this to a real URL (e.g. https://openrouter.ai/api/v1).
# Leave it commented out entirely for api.openai.com: the AI SDK validates
# OPENAI_BASE_URL eagerly and an EMPTY string crashes the app at boot.
#OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="gpt-4o-mini"

# === Elasticsearch (local docker or Elastic Cloud) ===
ELASTIC_URL="http://localhost:9200"
ELASTIC_API_KEY=""            # only needed for Elastic Cloud

# === KERNEL (cloud browser for the AI verification agent) ===
KERNEL_API_KEY=""             # https://dashboard.onkernel.com (hackathon: $50 credits)

# === Channel3 (product data API for price benchmarking) ===
CHANNEL3_API_KEY=""           # https://trychannel3.com/developers (promo: PAYPAL-HACKATHON-2026)

# === App ===
APP_URL="http://localhost:3000"
# Webhook id from PayPal developer dashboard (for signature verification)
PAYPAL_WEBHOOK_ID=""
